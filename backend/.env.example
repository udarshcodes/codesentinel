# CodeSentinel Environment Configuration
# Copy this file to .env and fill in your actual values

# Groq API Keys (Unified pool for GPT-OSS-20B, GPT-OSS-120B, Qwen 3.6 27B)
GROQ_API_KEY_1=gsk_your_key_1
GROQ_API_KEY_2=gsk_your_key_2
GROQ_API_KEY_3=gsk_your_key_3
GROQ_API_KEY_4=gsk_your_key_4
GROQ_API_KEY_5=gsk_your_key_5
GROQ_API_KEY_6=gsk_your_key_6

# GROQ_TOKENS_PER_KEY is determined dynamically via rate limit headers

# Admin Dashboard Secret
ADMIN_SECRET=change_me_to_a_strong_secret

# GitHub Personal Access Token (needs 'repo' scope)
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub Actions Worker Configuration
# The repo containing the worker.yml workflow (owner/repo format)
WORKER_REPO=udarshcodes/codesentinel

# Public URL of this backend — the GitHub Action worker posts state updates here
BACKEND_URL=http://localhost:8000

# Storage paths
TEMP_REPO_PATH=/tmp/repos
CHROMA_PERSIST_PATH=./chroma_data

# CORS allowed origins (comma-separated, used by FastAPI)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Alert webhook URL for key exhaustion notifications
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# --------------------------------------------------
# SECURITY CONFIGURATION (PRODUCTION ESSENTIALS)
# --------------------------------------------------
# GITHUB_WEBHOOK_SECRET
# Validates the authenticity of inbound GitHub webhooks (pushes, PRs, issues).
# Required in production to prevent forged payloads.
# GITHUB_WEBHOOK_SECRET=change_me_to_a_strong_github_webhook_secret

# WORKER_WEBHOOK_SECRET
# Authenticates the GitHub Actions worker when it posts state updates back to the API.
# Required in production to prevent state spoofing.
# WORKER_WEBHOOK_SECRET=change_me_to_a_strong_worker_secret

# --------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------
# CodeSentinel defaults to SQLite for local development and testing.
# For production deployments, an explicitly supported durable database (PostgreSQL) is REQUIRED.
# Production will NOT silently fall back to SQLite if DATABASE_URL is missing.
# DATABASE_URL=postgresql://username:password@host:5432/codesentinel
